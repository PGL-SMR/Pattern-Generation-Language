type int : unsigned int | int | unsigned long | long
type real : float | double

def inc(x) : ++x
def init(x) : x = 0
def comp(a, b) : a < b
def for(x, y) : for ($init(x); $comp(x, y); $inc(x))
def acc(a, b) : a += b | a = b + a
def mul(a, b) : (a) * (b) | (b) * (a)
def vector(x, i) : x[i]
def vector_inc(x, i, inc) : x[$mul(inc, i)]

decl axpy($int(n), $real(*x, *y, alpha)) {
  $int i;
  $for(i,n) {
    $acc($vector(y, i), $mul($vector(x, i), alpha));
  }
} = {
#include <stdio.h>
$if($real == float){
  printf("saxpy substituted\n");
}
$elif($real == double) {
  printf("daxpy substituted\n");
}
}

decl axpy_inc($int(n, incx, incy), $real(*x, *y, alpha)) {
  $int i;
  $for(i,n) {
    $acc($vector_inc(y, i, incy), $mul($vector_inc(x, i, incx), alpha));
  }
} = {
#include <stdio.h>
$if($real == float){
  printf("saxpy substituted\n");
}
$elif($real == double) {
  printf("daxpy substituted\n");
}
}